# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# -----------------
# FRONTEND CONFIG
# -----------------
# VITE_API_URL: Base URL for backend REST API. Leave empty for relative paths /api when proxied or set to full URL.
VITE_API_URL="http://localhost:5000/api"

# APP_URL: Public URL where the application is hosted
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Optional Gemini API Key for AI features
GEMINI_API_KEY=""

# -----------------
# BACKEND CONFIG
# -----------------
# PORT: Port where backend server runs
PORT="5000"

# GUNICORN_WORKERS: Number of WSGI worker processes in production Docker deployment
GUNICORN_WORKERS="4"

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins or '*'
CORS_ALLOWED_ORIGINS="*"

# -----------------
# DATABASE (PostgreSQL / Cloud SQL / AWS RDS / Azure Postgres)
# -----------------
# DATABASE_URL: Connection string for PostgreSQL database
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/storefront"

# DB Connection Pooling Configs
DB_POOL_SIZE="10"
DB_MAX_OVERFLOW="20"
DB_POOL_RECYCLE="300"

# -----------------
# REDIS (Azure Cache for Redis / AWS ElastiCache / Redis Cloud)
# -----------------
# REDIS_URL: Connection string for Redis cache server
# Format: redis://:<password>@<host>:<port>/0 or rediss:// for TLS
REDIS_URL="redis://localhost:6379/0"

# -----------------
# AUTHENTICATION & SECURITY
# -----------------
# JWT_SECRET_KEY: Secret key used to sign and verify JSON Web Tokens (Change in production!)
JWT_SECRET_KEY="super-secret-key-change-in-production"

# JWT_ACCESS_TOKEN_EXPIRES_SECONDS: Token validity duration in seconds (Default: 86400 = 24 hours)
JWT_ACCESS_TOKEN_EXPIRES_SECONDS="86400"
