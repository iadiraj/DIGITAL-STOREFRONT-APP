# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# -----------------
# FRONTEND CONFIG
# -----------------
VITE_API_URL=http://localhost:5001/api
APP_URL=http://localhost:3000
FRONTEND_PORT=3000
GEMINI_API_KEY=

# -----------------
# BACKEND CONFIG
# -----------------
# PORT = what the app listens on INSIDE container
PORT=5000
# BACKEND_HOST_PORT = what your Mac exposes (5001 avoids AirPlay conflict)
BACKEND_HOST_PORT=5001
GUNICORN_WORKERS=4
CORS_ALLOWED_ORIGINS=*

# -----------------
# DATABASE
# -----------------
DATABASE_URL=postgresql://user:password@postgres:5432/storefront
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=storefront
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# -----------------
# REDIS
# -----------------
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# -----------------
# AUTH
# -----------------
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=86400
